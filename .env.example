# JARVIS authentication
# Obtain these values from the Manus/OAuth app configuration for this project.
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
JWT_SECRET=

# Optional services
DATABASE_URL=
